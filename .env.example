# 로컬 미리보기용. 이 파일을 .env 로 복사해서 값을 채운다 (.env 는 커밋되지 않음)
# 사이트 입장 비밀번호. Vercel 환경변수 SITE_PASSWORD 와 같게 넣으면 정산 노트 '새로 정하기'가 로컬에서도 된다
SITE_PASSWORD=
# 비우면 dev/.data.json 가짜 저장소, 넣으면 실제 Neon
#DATABASE_URL=
# 영수증 사진 자동 등록 (Google AI Studio 무료 키, https://aistudio.google.com/apikey). Vercel 환경변수에도 같은 이름으로
GEMINI_API_KEY=
#GEMINI_MODEL=gemini-2.5-flash
