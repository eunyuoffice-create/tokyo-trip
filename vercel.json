{
  "buildCommand": "cd app && npm ci && npm run build",
  "outputDirectory": "app/dist",
  "rewrites": [{ "source": "/((?!api/|assets/|img/|sw.js|workbox-|registerSW.js|manifest.webmanifest|icon.svg).*)", "destination": "/index.html" }],
  "headers": [{ "source": "/sw.js", "headers": [{ "key": "Cache-Control", "value": "no-cache" }] }]
}
